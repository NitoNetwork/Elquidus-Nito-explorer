limit_req_zone $binary_remote_addr zone=nito_testnet_explorer_limit:10m rate=20r/s;

server {
    listen 80;
    listen [::]:80;
    server_name testnet-explorer.nito.network;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name testnet-explorer.nito.network;

    ssl_certificate /etc/letsencrypt/live/testnet-explorer.nito.network/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/testnet-explorer.nito.network/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        limit_req zone=nito_testnet_explorer_limit burst=80 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Powered-By;
    }
}
