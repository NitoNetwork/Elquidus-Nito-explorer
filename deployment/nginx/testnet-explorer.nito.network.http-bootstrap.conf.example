limit_req_zone $binary_remote_addr zone=nito_testnet_explorer_bootstrap_limit:10m rate=20r/s;

server {
    listen 80;
    listen [::]:80;
    server_name testnet-explorer.nito.network;

    location / {
        limit_req zone=nito_testnet_explorer_bootstrap_limit burst=80 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Powered-By;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }
}
