[Unit]
Description=Isolated PM2 daemon for the NITO testnet explorer
After=network.target mongod-testnet-explorer.service nitocoin-testnet.service
Wants=mongod-testnet-explorer.service nitocoin-testnet.service

[Service]
Type=forking
User=CHANGE_ME_EXPLORER_USER
Environment=PATH=/opt/nito-explorer-runtime/node-v24.22.3-linux-x64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PM2_HOME=/srv/nito-explorer-testnet/tmp/pm2-testnet
WorkingDirectory=/srv/nito-explorer-testnet
PIDFile=/srv/nito-explorer-testnet/tmp/pm2-testnet/pm2.pid
ExecStart=/opt/nito-explorer-runtime/node-v24.22.3-linux-x64/bin/node /srv/nito-explorer-testnet/node_modules/pm2/bin/pm2 resurrect
ExecReload=/opt/nito-explorer-runtime/node-v24.22.3-linux-x64/bin/node /srv/nito-explorer-testnet/node_modules/pm2/bin/pm2 reload all
ExecStop=/opt/nito-explorer-runtime/node-v24.22.3-linux-x64/bin/node /srv/nito-explorer-testnet/node_modules/pm2/bin/pm2 kill
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
