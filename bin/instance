#!/usr/bin/env node
var debug = require('debug')('explorer');
var settings = require('../lib/settings');
var db = require('../lib/database');
var app = require('../app');
var networkProfile = require('../lib/network-profile');

app.set('port', process.env.PORT || settings.webserver.port);

db.connect(null, async function() {
  var mongoose = require('mongoose');
  var server;

  try {
    await networkProfile.verify({database: mongoose.connection.db});
    server = app.listen(app.get('port'), settings.webserver.bind, function() {
      debug('Express server listening on port ' + server.address().port);
    });
  } catch (err) {
    console.error('Explorer startup refused: ' + err.message);
    await mongoose.connection.close(false).catch(() => {});
    process.exit(1);
    return;
  }

  process.on('SIGINT', () => {
    server.close(() => {
      mongoose.connection.close(false).then(() => {
        // close the main process now that all http and database connections have closed
        process.exit(0);
      }).catch((err) => {
        console.log(err);
        process.exit(1);
      });
    });
  });
});
