{
  "name": "explorer",
  "version": "1.102.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "description": "Public block explorer for NITO Core V4 with exact transparent and Orchard pool accounting.",
  "license": "BSD-3-Clause",
  "homepage": "https://explorer.nito.network/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NitoNetwork/Elquidus-Nito-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/NitoNetwork/Elquidus-Nito-explorer/issues"
  },
  "scripts": {
    "start": "node --stack-size=10000 ./bin/cluster",
    "stop": "node ./scripts/pm2.js stop ecosystem.config.js",
    "start-instance": "npm run prestart && node --stack-size=10000 ./bin/cluster 1",
    "start-forever": "node scripts/unsupported_forever.js",
    "stop-forever": "node scripts/unsupported_forever.js",
    "reload-forever": "node scripts/unsupported_forever.js",
    "start-pm2": "node scripts/prestart.js pm2 production",
    "start-pm2-debug": "node scripts/prestart.js pm2 development && node scripts/pm2.js logs",
    "stop-pm2": "node scripts/pm2.js stop ecosystem.config.js",
    "reload-pm2": "node scripts/pm2.js reload ecosystem.config.js --update-env",
    "status-pm2": "node scripts/pm2.js status",
    "save-pm2": "node scripts/pm2.js save",
    "test": "node ./node_modules/jasmine/bin/jasmine.js test/*Spec.js",
    "prestart": "node ./scripts/prestart.js",
    "sync-blocks": "node ./scripts/sync_nito.js",
    "sync-blocks-loop": "bash ./scripts/nito_v4_sync_loop.sh",
    "sync-markets": "node ./scripts/sync.js market",
    "sync-peers": "node ./scripts/sync.js peers",
    "sync-peers-loop": "node ./scripts/peer_sync_loop.js",
    "create-testnet-settings": "node ./scripts/create_testnet_settings.js",
    "sync-masternodes": "node ./scripts/sync.js masternodes",
    "check-blocks": "node ./scripts/sync_nito.js",
    "reindex": "node ./scripts/reindex_nito.js",
    "reindex-rich": "node ./scripts/reindex_nito.js",
    "rebuild-transparent-address-index": "node ./scripts/reindex_nito.js",
    "reindex-txcount": "node ./scripts/reindex_nito.js",
    "reindex-last": "node ./scripts/reindex_nito.js",
    "create-backup": "node ./scripts/unsupported_database_maintenance.js backup",
    "restore-backup": "node ./scripts/unsupported_database_maintenance.js restore",
    "delete-database": "node ./scripts/unsupported_database_maintenance.js delete",
    "update-explorer": "node ./scripts/update_explorer.js",
    "benchmark": "node ./scripts/benchmark.js",
    "test:v4": "node --test test/nito-*.test.js",
    "test:integration": "node --test test/integration/nito-regtest.test.js",
    "test:core": "node ./node_modules/jasmine/bin/jasmine.js test/explorerSpec.js",
    "validate:publication": "node ./scripts/validate_publication.js",
    "audit-index": "node scripts/audit_nito_index.js",
    "rollback-index": "node ./scripts/reindex_nito.js --rollback"
  },
  "dependencies": {
    "async": "^3.2.4",
    "bad-words": "^4.0.0",
    "body-parser": "1.20.9",
    "cookie-parser": "^1.4.6",
    "debug": ">=4.3.4",
    "express": "4.22.3",
    "intl": "^1.2.5",
    "jsonminify": "^0.4.2",
    "mongodb": "6.22.0",
    "mongoose": "8.24.10",
    "morgan": "1.12.1",
    "pm2": "7.1.2",
    "pug": "~3.0.2",
    "qr-image": "^3.2.0",
    "sass": "1.108.2",
    "serve-favicon": "^2.5.0",
    "undici": "7.30.2"
  },
  "devDependencies": {
    "jasmine": "5.13.0",
    "mongodb-memory-server": "10.4.3"
  },
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "overrides": {
    "jasmine": {
      "glob": "14.0.6"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "mongodb-memory-server": false
  }
}
