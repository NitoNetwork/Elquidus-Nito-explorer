extends layout

block content
  .col-12
    h3=settings.localization.rl_title.replace('{1}', settings.coin.name)
    if settings.richlist_page.page_header.show_last_updated && stats.blockchain_last_updated
      p.small.text-muted=settings.localization.last_updated + ': ' + new Date(stats.blockchain_last_updated * 1000).toISOString()
    p=settings.localization.nito_rich_scope
    if stats.pools
      p.small.breakWord=stats.pools.chain + ' · ' + stats.pools.blocks + ' · ' + stats.pools.bestblockhash
    else
      .alert.alert-warning=settings.localization.nito_unavailable
    .row
      .col-12.col-lg-8
        - const categories = Object.entries({balance, received}).filter(([key]) => key === 'balance' ? settings.richlist_page.show_current_balance : settings.richlist_page.show_received_coins)
        ul.nav.nav-tabs(role='tablist')
          each pair, index in categories
            li.nav-item(role='presentation')
              button.nav-link(id=pair[0] + '-tab', class=index === 0 ? 'active' : '', type='button', role='tab', data-bs-toggle='tab', data-bs-target='#' + pair[0], aria-controls=pair[0], aria-selected=index === 0 ? 'true' : 'false')=pair[0] === 'balance' ? settings.localization.rl_current_balance : settings.localization.rl_received_coins
        .tab-content
          each pair, tabIndex in categories
            - const [category, rows] = pair
            .tab-pane(id=category, class=tabIndex === 0 ? 'active' : '', role='tabpanel', aria-labelledby=category + '-tab')
              .table-responsive
                table.table.table-bordered.table-striped
                  thead
                    tr
                      th(scope='col') #
                      th(scope='col')=settings.localization.tx_address
                      th.text-end(scope='col')=settings.coin.symbol
                      if category == 'balance'
                        th.text-end(scope='col') %
                  tbody
                    each address, index in rows
                      tr
                        td=index + 1
                        td.breakWord
                          a(href='/address/' + address.a_id)=settings.claim_address_page.enabled && address.claim_name ? address.claim_name : address.a_id
                          include ./includes/rl_labels.pug
                        td.text-end.text-nowrap=nitoMoney.coins(address[category]).replace(/\B(?=(\d{3})+\.)/g, ',')
                        if category == 'balance'
                          td.text-end=stats.pools ? nitoMoney.percent(address.balance, stats.pools.transparent.chainValueNitoshi) || '—' : '—'
      .col-12.col-lg-4
        if stats.pools && stats.pools.activated === true
          - const poolRows = [[settings.localization.nito_supply_total, stats.pools.total.chainValue], [settings.localization.nito_supply_transparent, stats.pools.transparent.chainValue], [settings.localization.nito_supply_orchard, stats.pools.orchard.chainValue]]
          .card.cardSpacer.nito-rich-pool-summary
            .card-header=settings.localization.ex_supply + ' (' + settings.coin.symbol + ')'
            .card-body.py-1
              each poolRow in poolRows
                .d-flex.justify-content-between.gap-2
                  span=poolRow[0] + ':'
                  - const poolValue = poolRow[1].replace(/\B(?=(\d{3})+\.)/g, ',').replace(/(\.\d*?[1-9])0+$|\.0+$/, '$1')
                  strong.text-end.text-nowrap=poolValue
        .card.cardSpacer
          .card-header=settings.localization.rl_wealth + ' · ' + settings.localization.nito_supply_transparent
          .card-body
            p.small=settings.localization.nito_chart_scope
            if settings.richlist_page.wealth_distribution.show_distribution_table
              .table-responsive
                table.table.table-bordered.table-striped
                  thead
                    tr
                      th(scope='col')=settings.localization.rl_wealth
                      th.text-end(scope='col')=settings.coin.symbol
                      th.text-end(scope='col') %
                  tbody
                    each group, index in [dista, distb, distc, distd, diste]
                      if index === 4 && stats.pools
                        - const topTotal = balance.slice(0, 100).reduce((sum, address) => sum + BigInt(address.balance), BigInt(0))
                        tr
                          th(scope='row')=settings.localization.rl_current_balance
                          td.text-end.text-nowrap=nitoMoney.coins(topTotal).replace(/\B(?=(\d{3})+\.)/g, ',')
                          td.text-end=nitoMoney.percent(topTotal, stats.pools.transparent.chainValueNitoshi) || '—'
                      tr
                        th(scope='row')=index < 4 ? (index * 25 + 1) + '–' + ((index + 1) * 25) : settings.localization.nito_other
                        td.text-end.text-nowrap=group.total == null ? settings.localization.nito_unavailable : group.total.replace(/\B(?=(\d{3})+\.)/g, ',')
                        td.text-end=group.percent == null ? '—' : group.percent
                    tr
                      th(scope='row')=settings.localization.nito_supply_total
                      td.text-end.text-nowrap=stats.pools ? stats.pools.transparent.chainValue.replace(/\B(?=(\d{3})+\.)/g, ',') : settings.localization.nito_unavailable
                      td.text-end=stats.pools && BigInt(stats.pools.transparent.chainValueNitoshi) > BigInt(0) ? '100.00' : '—'
            if settings.richlist_page.wealth_distribution.show_distribution_chart && stats.pools
              canvas#pieChart(role='img', aria-label=settings.localization.nito_rich_scope)=settings.localization.nito_chart_scope
              script.
                $(function () {
                  if (typeof Chart === 'undefined') return;
                  const groups = !{JSON.stringify([dista, distb, distc, distd, diste])};
                  const labels = !{JSON.stringify([settings.localization.rl_top25, settings.localization.rl_top50, settings.localization.rl_top75, settings.localization.rl_top100, settings.localization.nito_other])};
                  new Chart('pieChart', {type: 'pie', data: {labels, datasets: [{backgroundColor: !{JSON.stringify(settings.richlist_page.wealth_distribution.colors)}, data: groups.map(g => Number(g.percent))}]}, options: {
                    animation: !window.matchMedia('(prefers-reduced-motion: reduce)').matches,
                    plugins: {legend: {display: false}, tooltip: {callbacks: {label: c => labels[c.dataIndex] + ': ' + NitoAmount.format(groups[c.dataIndex].total) + ' (' + groups[c.dataIndex].percent + '%)'}}}
                  }});
                });
