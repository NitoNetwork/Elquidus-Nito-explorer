extends layout

block content
  .col-12
    h3=settings.localization.tx_title.replace('{1}', settings.coin.name)
    if tx.confirmations != null && tx.confirmations < 0
      .alert.alert-warning=settings.localization.nito_orphan
    if !tx.metadata_complete
      .alert.alert-warning=settings.localization.nito_incomplete
    .card.cardSpacer
      .card-body
        dl.row.mb-0
          dt.col-12.col-md-3=settings.localization.tx_hash
          dd.col-12.col-md-9.breakWord=tx.txid
          dt.col-12.col-md-3=settings.localization.tx_block_hash
          dd.col-12.col-md-9.breakWord
            if tx.blockhash
              a(href='/block/' + tx.blockhash)=tx.blockhash
            else
              =settings.localization.nito_unavailable
          dt.col-6.col-md-3=settings.localization.confirmations
          dd.col-6.col-md-9=tx.confirmations == null ? settings.localization.nito_unavailable : tx.confirmations
          dt.col-6.col-md-3=settings.localization.size
          dd.col-6.col-md-9=tx.size == null ? settings.localization.nito_unavailable : tx.size + ' B'
          dt.col-6.col-md-3=settings.localization.timestamp
          dd.col-6.col-md-9=tx.timestamp == null ? settings.localization.nito_unavailable : new Date(tx.timestamp * 1000).toISOString()
          dt.col-6.col-md-3=settings.localization.nito_fee
          dd.col-6.col-md-9=tx.coinbase ? '—' : tx.fee_nitoshi == null ? settings.localization.nito_unavailable : nitoMoney.coins(tx.fee_nitoshi) + ' ' + settings.coin.symbol
          dt.col-6.col-md-3=settings.localization.nito_privacy
          dd.col-6.col-md-9=tx.privacy == 'orchard' ? 'Orchard' : tx.privacy == 'transparent' ? settings.localization.nito_outputs : settings.localization.nito_unavailable
    if tx.privacy == 'orchard'
      .card.cardSpacer
        .card-header: strong Orchard
        .card-body
          dl.row.mb-0
            dt.col-12.col-md-6=settings.localization.nito_actions
            dd.col-12.col-md-6=tx.orchard && tx.orchard.actions != null ? tx.orchard.actions : settings.localization.nito_unavailable
            if orchardMovement
              dt.col-12.col-md-6=orchardMovement.direction == 'entry' ? settings.localization.nito_pool_entry : orchardMovement.direction == 'exit' ? settings.localization.nito_pool_exit : settings.localization.nito_pool_movement
              dd.col-12.col-md-6=nitoMoney.coins(orchardMovement.amount_nitoshi) + ' ' + settings.coin.symbol
            else
              dt.col-12.col-md-6=settings.localization.nito_pool_movement
              dd.col-12.col-md-6=settings.localization.nito_unavailable
    .row
      each rows, side in {vin: tx.vin, vout: tx.vout}
        - var displayRows = side == 'vout' && tx.coinbase ? rows.filter(function(row) { return row.script_type != 'nulldata'; }) : rows
        .col-12.col-lg-6.cardSpacer
          .card
            .card-header: strong=side == 'vin' ? settings.localization.nito_inputs : settings.localization.nito_outputs
            if displayRows.length == 0
              .card-body=side == 'vin' ? settings.localization.nito_no_inputs : settings.localization.nito_no_outputs
            else
              .table-responsive
                table.table.table-striped.mb-0
                  thead
                    tr
                      th=settings.localization.tx_address
                      th.text-end=settings.coin.symbol
                  tbody
                    each row in displayRows
                      if side == 'vin' && row.addresses == 'coinbase'
                        tr.table-info
                          td.text-center(colspan='2')=settings.localization.new_coins
                      else
                        tr
                          td.breakWord
                            if row.addresses
                              a(href='/address/' + row.addresses)=row.addresses
                            else
                              =row.script_type || settings.localization.nito_unavailable
                              if row.script
                                details
                                  summary Script
                                  code.breakWord=row.script
                          td.text-end=row.amount == null ? settings.localization.nito_unavailable : nitoMoney.coins(row.amount)
