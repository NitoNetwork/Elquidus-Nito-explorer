section#nito-pools.card.card-default.cardSpacer(aria-label=settings.localization.ex_supply, hidden)
  .card-header
    strong #{settings.localization.ex_supply} (#{settings.coin.symbol})
  .card-body
    .row.g-3
      each label, key in {total: settings.localization.nito_supply_total, transparent: settings.localization.nito_supply_transparent, orchard: settings.localization.nito_supply_orchard}
        .col-12.col-md-4
          strong=label
          div.breakWord(data-pool=key)=settings.localization.nito_unavailable
    small#nito-pool-tip.text-muted
    p.small.mb-0=settings.localization.nito_pool_scope
script.
  $(function () {
    function clearPools() {
      $('#nito-pools').prop('hidden', true);
      $('[data-pool]').text('#{settings.localization.nito_unavailable}');
      $('#nito-pool-tip').text('');
    }
    function refreshPools() {
      $.ajax({url: '/ext/getorchardpools', dataType: 'json', timeout: 10000}).done(function (p) {
        if (p.status !== 'available' || p.activated !== true) { clearPools(); return; }
        ['transparent', 'orchard', 'total'].forEach(function (key) {
          $('[data-pool="' + key + '"]').text(NitoAmount.format(p[key].chainValue) + ' #{settings.coin.symbol}');
        });
        $('#nito-pool-tip').text(p.chain + ' · #{settings.localization.height} ' + p.blocks + ' · ' + p.bestblockhash).addClass('breakWord');
        $('#nito-pools').prop('hidden', false);
      }).fail(clearPools);
    }
    refreshPools();
    const poolTimer = setInterval(refreshPools, 60000);
    window.addEventListener('pagehide', function () { clearInterval(poolTimer); }, {once: true});
  });
